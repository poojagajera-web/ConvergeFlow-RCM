    {
      "@type": "FAQPage",
      "@id": "https://marketing-domain.invalid/services/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does ConvergeFlow deliver every stage listed here?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That has not been confirmed. The services menu describes areas of the revenue cycle for evaluation. Current evidence establishes specific product views, while processing, payer connectivity and support for additional stages require confirmation. Ask to see the workflow you need rather than assuming that a menu label establishes operational availability."
          }
        },
        {
          "@type": "Question",
          "name": "Is this an outsourced billing service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A managed billing service has not been confirmed. ConvergeFlow has been reviewed as a product with operational views. If your team needs someone to perform tasks on its behalf, discuss staffing, ownership and delivery scope explicitly. Do not assume that software access includes outsourced execution or payer follow-up."
          }
        },
        {
          "@type": "Question",
          "name": "How should we choose the first workflow to review?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with a task whose inputs, owner and unresolved question your team can describe. Bring a de-identified example and identify what the next staff member needs to know. Follow that task through the relevant views, recording what is demonstrated and what still needs confirmation for your practice."
          }
        },
        {
          "@type": "Question",
          "name": "Can we discuss pricing and implementation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, bring those questions to the product discussion. This draft does not publish prices, implementation timelines or included service commitments because those terms have not been confirmed. Establish the required workflow and available product scope, then request the commercial and implementation details relevant to that scope."
          }
        }
      ]
    },
