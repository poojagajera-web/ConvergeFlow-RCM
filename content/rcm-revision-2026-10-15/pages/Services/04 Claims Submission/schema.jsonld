    {
      "@type": "FAQPage",
      "@id": "https://marketing-domain.invalid/services/claims-submission/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can ConvergeFlow transmit claims today?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Transmission has not been validated in the read-only review. The product includes claims and submission-queue interfaces, but those views do not establish that a claim can be sent through a particular clearinghouse or payer. Ask to see the supported action, response and requirements for your practice before relying on it."
          }
        },
        {
          "@type": "Question",
          "name": "Does the product scrub claims before submission?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Scrubbing behavior has not been confirmed. If your team needs claim checks, ask which fields or rules are examined, what the product reports and how staff resolve a flagged item. Do not assume that a submission queue includes automated checks or that any check guarantees acceptance or payment."
          }
        },
        {
          "@type": "Question",
          "name": "What should we inspect beyond the queue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Inspect the source information, available actions and evidence of the resulting status. Ask what happens when an action fails or a response is incomplete. Include the staff member who owns corrections so your evaluation covers the next review step, rather than stopping at the appearance of a submitted label."
          }
        },
        {
          "@type": "Question",
          "name": "Does verification guarantee a clean claim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Verification and claim preparation answer different questions. Keep the information reviewed, unresolved requirements and billing decisions separate. Follow your practice’s approved checks for the claim in question. Neither an eligibility flag nor a verification task status establishes that every claim requirement has been satisfied or that payment will follow."
          }
        }
      ]
    }
  ]
}