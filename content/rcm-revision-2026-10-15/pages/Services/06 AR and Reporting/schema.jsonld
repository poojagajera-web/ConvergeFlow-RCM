    {
      "@type": "FAQPage",
      "@id": "https://marketing-domain.invalid/services/ar-management/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does AR visibility mean collection work is automated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A balance or aging view does not establish automated collection activity. The reviewed evidence confirms interfaces rather than operational results. Ask which actions are available, who performs follow-up and how changes reach the account record. Confirm those responsibilities before planning your receivables process around the product."
          }
        },
        {
          "@type": "Question",
          "name": "Can we export the reports?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Export controls were observed, but export execution and output content were not tested. Ask to see the available format, fields, filters and resulting file for your reporting question. Confirm the scope and behavior you need before promising a reporting output to another team or changing an existing reporting process."
          }
        },
        {
          "@type": "Question",
          "name": "Does the audit view establish compliance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. An audit interface provides activity fields to inspect; it does not establish a certification, regulatory compliance or a complete record of every action. Discuss your organization’s evidence requirements separately and request relevant documentation. Do not infer access, retention or data-protection commitments from the presence of an audit table."
          }
        },
        {
          "@type": "Question",
          "name": "Can reports show every practice in a group?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The product includes practice context, but the reporting scope needed for a group must be confirmed. Bring the practice structure and questions your team needs to answer. Ask how filters relate, which records are included and what comparison is valid before treating a summary as a group-wide operating view."
          }
        }
      ]
    }
  ]
